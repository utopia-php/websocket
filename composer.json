{
    "name": "utopia-php/mqtt",
    "description": "A simple abstraction for MQTT servers.",
    "type": "library",
    "keywords": ["php","framework", "upf", "utopia", "mqtt"],
    "license": "MIT",
    "scripts": {
        "check": "./vendor/bin/phpstan analyse --level max src tests"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {"Utopia\\MQTT\\": "src/MQTT"}
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "swoole/ide-helper": "4.6.6",
        "textalk/websocket": "1.5.2",
        "phpunit/phpunit": "^9.5.5",
        "vimeo/psalm": "^4.8.1",
        "workerman/workerman": "^4.0",
        "phpstan/phpstan": "^1.8"
    }
}
